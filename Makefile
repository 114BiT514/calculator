####### Compile

main.o: main.cpp mainwindow.h \
		calculatorengine.h \
		financedialog.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o main.cpp

mainwindow.o: mainwindow.cpp mainwindow.h \
		calculatorengine.h \
		financedialog.h \
		ui_mainwindow.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o mainwindow.o mainwindow.cpp

calculatorengine.o: calculatorengine.cpp calculatorengine.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o calculatorengine.o calculatorengine.cpp

financedialog.o: financedialog.cpp financedialog.h \
		ui_financedialog.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o financedialog.o financedialog.cpp

qrc_resources.o: qrc_resources.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o qrc_resources.o qrc_resources.cpp

moc_mainwindow.o: moc_mainwindow.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_mainwindow.o moc_mainwindow.cpp

moc_financedialog.o: moc_financedialog.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_financedialog.o moc_financedialog.cpp

####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/calculator/bin || mkdir -p $(INSTALL_ROOT)/opt/calculator/bin
	$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/opt/calculator/bin/$(QMAKE_TARGET)
	-$(STRIP) $(INSTALL_ROOT)/opt/calculator/bin/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/opt/calculator/bin/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/calculator/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

