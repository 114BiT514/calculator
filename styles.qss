/* 财务计算器样式表 */

/* 主窗口背景 */
QMainWindow {
    background-color: #f0f0f0;
}

/* 标题标签 */
QLabel#label {
    font-size: 24px;
    font-weight: bold;
    color: #2c3e50;
    padding: 10px;
    background-color: transparent;
}

/* 普通标签 */
QLabel {
    font-size: 14px;
    color: #34495e;
}

/* 显示区域 */
QLineEdit {
    background-color: white;
    border: 2px solid #bdc3c7;
    border-radius: 5px;
    padding: 8px;
    font-size: 16px;
    color: #2c3e50;
}

QLineEdit:focus {
    border-color: #3498db;
}

/* 数字按钮 - 浅灰底深灰文字 */
QPushButton {
    background-color: #ecf0f1;
    border: 1px solid #bdc3c7;
    border-radius: 5px;
    padding: 10px;
    font-size: 16px;
    color: #2c3e50;
    min-height: 40px;
}

QPushButton:hover {
    background-color: #d5dbdb;
    border-color: #3498db;
}

QPushButton:pressed {
    background-color: #bdc3c7;
}

/* 运算符按钮 - 与数字按钮同风格，但文字蓝色加粗 */
QPushButton#pushButton_add,
QPushButton#pushButton_minu,
QPushButton#pushButton_mul,
QPushButton#pushButton_div {
    color: #3498db;
    font-weight: bold;
}

/* 清除按钮 - 白底红色文字 */
QPushButton#pushButton_c {
    background-color: white;
    border: 1px solid #e74c3c;
    color: #e74c3c;
    font-weight: bold;
}

QPushButton#pushButton_c:hover {
    background-color: #e74c3c;
    color: white;
}

QPushButton#pushButton_c:pressed {
    background-color: #c0392b;
    color: white;
}

/* 退格按钮 - 白底深灰文字，文字稍大 */
QPushButton#pushButton_rm {
    background-color: white;
    border: 1px solid #bdc3c7;
    color: #7f8c8d;
}

/* 计算按钮 - 蓝色背景白色文字（主要操作按钮） */
QPushButton#pushButton_cal {
    background-color: #3498db;
    border: 1px solid #3498db;
    color: white;
    font-weight: bold;
    font-size: 20px;
}

QPushButton#pushButton_cal:hover {
    background-color: #2980b9;
    border-color: #2980b9;
}

QPushButton#pushButton_cal:pressed {
    background-color: #2470a0;
    border-color: #2470a0;
}

/* 财务计算按钮 - 深蓝色背景白色文字 */
QPushButton#pushButton_simple,
QPushButton#pushButton_compound {
    background-color: #2980b9;
    border: 1px solid #2980b9;
    color: white;
    font-weight: bold;
}

QPushButton#pushButton_simple:hover,
QPushButton#pushButton_compound:hover {
    background-color: #2470a0;
    border-color: #2470a0;
}

QPushButton#pushButton_simple:pressed,
QPushButton#pushButton_compound:pressed {
    background-color: #1f618d;
    border-color: #1f618d;
}

/* 财务参数设置按钮 - 蓝绿背景白色文字 */
QPushButton#pushButton {
    background-color: #16a085;
    border: 1px solid #16a085;
    color: white;
    font-weight: bold;
    min-width: 120px;
}

QPushButton#pushButton:hover {
    background-color: #138d75;
    border-color: #138d75;
}

QPushButton#pushButton:pressed {
    background-color: #117a64;
    border-color: #117a64;
}

/* 状态栏 */
QStatusBar {
    background-color: #34495e;
    color: white;
    border: none;
}

/* 对话框样式 */
QDialog {
    background-color: #f0f0f0;
}

QDialog QLabel {
    font-size: 14px;
    color: #2c3e50;
}

QDialog QLineEdit {
    background-color: white;
    border: 1px solid #bdc3c7;
    border-radius: 3px;
    padding: 5px;
}

QDialog QPushButton {
    min-width: 80px;
    padding: 5px 15px;
}

QDialog QPushButton:hover {
    background-color: #3498db;
    color: white;
}

QDialog QPushButton:pressed {
    background-color: #2980b9;
}